        "description": "Address space for the DEV VNet. Must not overlap with connected networks."
      }
    }
  },
  "variables": {
    "prefix": "[format('pm-{0}', parameters('environment'))]",
    "suffix": "[uniqueString(resourceGroup().id)]"
