{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchmind.example/schemas/telemetry/v1/tracking-frame.schema.json",
  "title": "PitchMind canonical telemetry tracking frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matchId", "canonicalRevision", "frameId", "sequence", "matchTime", "coordinateSystem", "ball", "players", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matchId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
    "canonicalRevision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "frameId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "matchTime": { "$ref": "event-envelope.schema.json#/$defs/matchTime" },
    "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" },
    "ball": { "$ref": "#/$defs/point" },
    "players": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/player" } },
    "source": { "$ref": "event-envelope.schema.json#/$defs/source" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "teamId", "position"],
      "properties": {
        "playerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
        "teamId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
        "position": { "$ref": "#/$defs/point" }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengthMetres", "widthMetres", "unit", "axisOrigin", "teamDirections"],
      "properties": {
        "lengthMetres": { "type": "number", "minimum": 90, "maximum": 120 },
        "widthMetres": { "type": "number", "minimum": 45, "maximum": 90 },
        "unit": { "enum": ["metres", "normalized_0_1", "percent_0_100"] },
        "axisOrigin": { "enum": ["bottom_left", "top_left"] },
        "teamDirections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["teamId", "direction"],
            "properties": {
              "teamId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": ".*\\S.*" },
              "direction": { "enum": ["left", "right"] }
            }
          }
        }
      }
    }
  }
}
