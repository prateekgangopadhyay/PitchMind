{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchmind.example/schemas/telemetry/v1/event-envelope.schema.json",
  "title": "PitchMind canonical telemetry event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matchId", "canonicalRevision", "eventId", "sequence", "matchTime", "eventType", "sourceEventType", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matchId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "canonicalRevision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "matchTime": { "$ref": "#/$defs/matchTime" },
    "eventType": { "enum": ["KickOff", "Pass", "Shot", "Goal", "Foul", "Turnover", "FullTime", "Pressure", "HalfTime", "BallRecovery", "Carry", "Clearance", "Interception", "PressureApplied", "PossessionLost", "ProgressivePass", "ProgressiveCarry", "LineBreakingPass", "Tackle", "Substitution", "YellowCard", "RedCard"] },
    "sourceEventType": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "teamId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "playerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "relatedPlayerId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "outcome": { "type": ["string", "null"], "minLength": 1, "maxLength": 256, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
    "coordinateSystem": { "anyOf": [{ "$ref": "#/$defs/coordinateSystem" }, { "type": "null" }] },
    "location": { "anyOf": [{ "$ref": "#/$defs/eventLocation" }, { "type": "null" }] },
    "source": { "$ref": "#/$defs/source" }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "Substitution" } } },
      "then": {
        "description": "relatedPlayerId must identify a participant different from playerId; the runtime validator enforces this cross-field constraint.",
        "required": ["relatedPlayerId"],
        "properties": { "relatedPlayerId": { "type": "string", "minLength": 1, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" } }
      }
    },
    {
      "if": { "properties": { "eventType": { "enum": ["Pass", "Shot", "Goal", "Foul", "Turnover", "Pressure", "PressureApplied", "BallRecovery", "Carry", "Clearance", "Interception", "PossessionLost", "ProgressivePass", "ProgressiveCarry", "LineBreakingPass", "Tackle", "Substitution", "YellowCard", "RedCard"] } } },
      "then": { "required": ["teamId", "playerId"] }
    },
    {
      "if": { "properties": { "location": { "type": "object" } } },
      "then": { "required": ["coordinateSystem"], "properties": { "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" } } }
    },
    {
      "if": { "properties": { "coordinateSystem": { "type": "object" } } },
      "then": { "required": ["location"], "properties": { "location": { "$ref": "#/$defs/eventLocation" } } }
    }
  ],
  "$defs": {
    "dotnetDecimalNonNegative": {
      "minimum": 0,
      "anyOf": [
      { "type": "number", "multipleOf": 1, "maximum": 79228162514264337593543950335 },
      { "type": "number", "multipleOf": 0.1, "maximum": 7922816251426433759354395033.5 },
      { "type": "number", "multipleOf": 0.01, "maximum": 792281625142643375935439503.35 },
      { "type": "number", "multipleOf": 0.001, "maximum": 79228162514264337593543950.335 },
      { "type": "number", "multipleOf": 0.0001, "maximum": 7922816251426433759354395.0335 },
      { "type": "number", "multipleOf": 0.00001, "maximum": 792281625142643375935439.50335 },
      { "type": "number", "multipleOf": 0.000001, "maximum": 79228162514264337593543.950335 },
      { "type": "number", "multipleOf": 0.0000001, "maximum": 7922816251426433759354.3950335 },
      { "type": "number", "multipleOf": 0.00000001, "maximum": 792281625142643375935.43950335 },
      { "type": "number", "multipleOf": 0.000000001, "maximum": 79228162514264337593.543950335 },
      { "type": "number", "multipleOf": 0.0000000001, "maximum": 7922816251426433759.3543950335 },
      { "type": "number", "multipleOf": 0.00000000001, "maximum": 792281625142643375.93543950335 },
      { "type": "number", "multipleOf": 0.000000000001, "maximum": 79228162514264337.593543950335 },
      { "type": "number", "multipleOf": 0.0000000000001, "maximum": 7922816251426433.7593543950335 },
      { "type": "number", "multipleOf": 0.00000000000001, "maximum": 792281625142643.37593543950335 },
      { "type": "number", "multipleOf": 0.000000000000001, "maximum": 79228162514264.337593543950335 },
      { "type": "number", "multipleOf": 0.0000000000000001, "maximum": 7922816251426.4337593543950335 },
      { "type": "number", "multipleOf": 0.00000000000000001, "maximum": 792281625142.64337593543950335 },
      { "type": "number", "multipleOf": 0.000000000000000001, "maximum": 79228162514.264337593543950335 },
      { "type": "number", "multipleOf": 0.0000000000000000001, "maximum": 7922816251.4264337593543950335 },
      { "type": "number", "multipleOf": 0.00000000000000000001, "maximum": 792281625.14264337593543950335 },
      { "type": "number", "multipleOf": 0.000000000000000000001, "maximum": 79228162.514264337593543950335 },
      { "type": "number", "multipleOf": 0.0000000000000000000001, "maximum": 7922816.2514264337593543950335 },
      { "type": "number", "multipleOf": 0.00000000000000000000001, "maximum": 792281.62514264337593543950335 },
      { "type": "number", "multipleOf": 0.000000000000000000000001, "maximum": 79228.162514264337593543950335 },
      { "type": "number", "multipleOf": 0.0000000000000000000000001, "maximum": 7922.8162514264337593543950335 },
      { "type": "number", "multipleOf": 0.00000000000000000000000001, "maximum": 792.28162514264337593543950335 },
      { "type": "number", "multipleOf": 0.000000000000000000000000001, "maximum": 79.228162514264337593543950335 },
      { "type": "number", "multipleOf": 0.0000000000000000000000000001, "maximum": 7.9228162514264337593543950335 }
      ]
    },
    "matchTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "elapsedSeconds", "sourceClockValue", "sourceClockUnit", "sourceClockBasis"],
      "properties": {
        "period": { "type": "integer", "minimum": 1, "maximum": 5 },
        "elapsedSeconds": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "sourceClockValue": { "$ref": "#/$defs/dotnetDecimalNonNegative" },
        "sourceClockUnit": { "enum": ["seconds", "milliseconds", "provider_defined"] },
        "sourceClockBasis": { "enum": ["match_elapsed", "period_elapsed", "provider_defined"] }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/dotnetDecimalNonNegative" },
        "y": { "$ref": "#/$defs/dotnetDecimalNonNegative" }
      }
    },
    "eventLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "anyOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
        "end": { "anyOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] }
      },
      "anyOf": [
        { "required": ["start"], "properties": { "start": { "$ref": "#/$defs/point" } } },
        { "required": ["end"], "properties": { "end": { "$ref": "#/$defs/point" } } }
      ]
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengthMetres", "widthMetres", "unit", "axisOrigin", "teamDirections"],
      "properties": {
        "lengthMetres": { "allOf": [{ "$ref": "#/$defs/dotnetDecimalNonNegative" }, { "minimum": 90, "maximum": 120 }] },
        "widthMetres": { "allOf": [{ "$ref": "#/$defs/dotnetDecimalNonNegative" }, { "minimum": 45, "maximum": 90 }] },
        "unit": { "enum": ["metres", "normalized_0_1", "percent_0_100"] },
        "axisOrigin": { "enum": ["bottom_left", "top_left"] },
        "teamDirections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["teamId", "direction"],
            "properties": {
              "teamId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
              "direction": { "enum": ["left", "right"] }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "sourceMatchId", "sourceRecordId", "sourceSequence", "sourceSchemaVersion", "sourceSha256", "provenanceStatus", "rightsReviewStatus"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
        "sourceMatchId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
        "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
        "sourceSequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "sourceSchemaVersion": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
        "sourceSha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
        "sourceTimestampUtc": { "type": ["string", "null"], "maxLength": 64, "format": "date-time", "pattern": "(?:Z|[+-]00:00)$" },
        "provenanceStatus": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]" },
        "rightsReviewStatus": { "const": "approved_for_use", "description": "Independent review approved this source for canonical telemetry use." }
      }
    }
  }
}
